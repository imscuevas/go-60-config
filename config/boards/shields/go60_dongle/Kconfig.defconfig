if SHIELD_GO60_DONGLE

config ZMK_KEYBOARD_NAME
    default "Go60 Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# 2 peripherals: Left half and Right half
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 peripherals + 5 BT host profiles = 7
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

# Battery fetching from peripherals for display
config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

config ZMK_BATTERY_REPORTING
    default y

config ZMK_BATTERY_REPORTING_SPLIT_REPORT_LOWEST_CHARGE
    default n

# Pointing / Mouse support
config ZMK_POINTING
    default y

endif
