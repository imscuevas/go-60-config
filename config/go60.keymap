#include <behaviors.dtsi>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/pointing.h>

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

// layers
#define LAYER_Base 0
#define LAYER_Nav 1
#define LAYER_Media 2
#define LAYER_Numbers 3
#define LAYER_Magic 4


/ {
    input_processors {
        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
        };
        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            bindings = <&mo>, <&kp>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <0>;
        };
        bt_clr_all: bluetooth_clear_all {
            compatible = "zmk,behavior-tap-dance";
            label = "Bluetooth Clear/Clear all";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt BT_CLR>, <&bt BT_CLR_ALL>;
        };
        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };
        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };
        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };
        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };
        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };
        bt_4: bt_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_4>, <&bt BT_DISC 4>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_select_0: bt_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };
        bt_select_1: bt_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };
        bt_select_2: bt_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };
        bt_select_3: bt_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
        bt_select_4: bt_select_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_Base {
            bindings = <
                &magic LAYER_Magic 0    &none       &none       &none       &none                   &none                                                       &none                   &none       &none       &none       &none       &none
                &none                   &kp DOT     &kp COMMA   &kp SEMI    &kp P                   &kp Y                                                       &kp F                   &kp G       &kp C       &kp H       &kp L       &kp MINUS
                &kp CAPS                &hm LGUI A  &hm LALT O  &hm LCTRL E &hm LSHFT U             &kp I                                                       &kp D                   &hm RSHFT R &hm RCTRL T &hm LALT N  &hm RGUI S  &kp SQT
                &none                   &kp FSLH    &hm RALT Q  &kp J       &kp K                   &kp X                                                       &kp B                   &kp M       &kp W       &hm RALT V  &kp Z       &none
                                                    &none       &none       &ltq LAYER_Media ESC                                                                                        &kp DEL     &none       &none
                                                                                                    &ltq LAYER_Nav SPACE    &kp TAB &none   &none   &kp BSPC    &ltq LAYER_Numbers RET
            >;
        };

        layer_Nav {
            bindings = <
                &none   &none       &none       &none       &none       &none                                       &none       &none       &none       &none       &none       &none
                &none   &none       &none       &none       &none       &none                                       &kp LC(Z)   &kp LC(V)   &kp LC(C)   &kp LC(X)   &kp LC(Y)   &none
                &none   &kp LGUI    &kp LALT    &kp LCTRL   &kp LSHFT   &none                                       &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &none       &none
                &none   &none       &kp RALT    &none       &none       &none                                       &kp HOME    &kp PG_DN   &kp PG_UP   &kp END     &kp INS     &none
                                    &none       &none       &none                                                               &kp DEL     &none       &none
                                                                        &none   &none   &none   &none   &kp BSPC    &kp RET
            >;
        };

        layer_Media {
            bindings = <
                &none   &none       &none       &none       &none       &none                                       &none           &none           &none           &none           &none           &none
                &none   &none       &none       &none       &none       &none                                       &kp C_BRI_MIN   &kp C_BRI_DN    &kp C_BRI_UP    &kp C_BRI_MAX   &kp C_BRI_AUTO  &bt_clr_all
                &none   &kp LGUI    &kp LALT    &kp LCTRL   &kp LSHFT   &none                                       &kp C_PREV      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_NEXT      &out OUT_USB    &none
                &none   &none       &kp RALT    &none       &none       &none                                       &bt_0           &bt_1           &bt_2           &bt_3           &bt_4           &none
                                    &none       &none       &none                                                                   &kp C_MUTE      &none           &none
                                                                        &none   &none   &none   &none   &kp C_STOP  &kp C_PP
            >;
        };

        layer_Numbers {
            bindings = <
                &none   &none       &none   &none  &none     &none                                          &none   &none       &none       &none       &none       &none
                &none   &kp SQT     &kp N7  &kp N8 &kp N9    &kp BSLH                                       &none   &none       &none       &kp RALT    &none       &none
                &none   &kp LBKT    &kp N4  &kp N5 &kp N6    &kp RBKT                                       &none   &kp RSHFT   &kp LCTRL   &kp LALT    &kp RGUI    &none
                &none   &kp NUBS    &kp N1  &kp N2 &kp N3    &kp GRAVE                                      &none   &none       &kp COMMA   &kp DOT     &kp FSLH    &none
                                    &none   &none  &kp EQUAL                                                        &none       &none       &none
                                                             &kp N0     &kp MINUS   &none   &none   &none   &none
            >;
        };

        layer_Magic {
            bindings = <
                &bt BT_CLR  &kp C_BRI_DN    &kp C_BRI_UP    &kp C_PREV      &kp C_NEXT      &kp C_PP                                            &kp C_MUTE  &kp C_VOL_DN    &kp C_VOL_UP    &none   &none   &bt BT_CLR_ALL
                &bootloader &rgb_ug RGB_SPI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                     &none       &none           &none           &none   &none   &bootloader
                &sys_reset  &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                     &none       &none           &none           &none   &none   &sys_reset
                &none       &bt_0           &bt_1           &bt_2           &bt_3           &bt_4                                               &none       &none           &none           &none   &none   &none
                                            &out OUT_USB    &none           &none                                                                           &none           &none           &none
                                                                                            &none           &none   &none   &none   &none       &none
            >;
        };
    };
};

&cirque_rh_listener {
    input-processors = <&zip_xy_scaler 1 1>;
};

&cirque_lh_listener {
    input-processors = <&zip_xy_to_scroll_mapper>, <&zip_xy_scaler 1 8>, <&zip_click_to_right_click_mapper>;
};
